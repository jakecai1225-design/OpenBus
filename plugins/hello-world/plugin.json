{
    "name": "hello-world",
    "version": "1.0.0",
    "author": "sin",
    "description": "最简示例插件 — 演示插件系统的基本用法",
    "main": "main.py",
    "activationEvents": [
        "onStartup",
        "onCommand:helloWorld.say"
    ],
    "contributes": {
        "commands": [
            { "id": "helloWorld.say", "title": "Hello World: 打招呼" }
        ]
    }
}
