{
    "name": "frame-counter",
    "version": "1.0.0",
    "author": "sin",
    "description": "帧统计插件 — 统计接收到的 CAN 帧数量和 ID 分布",
    "main": "main.py",
    "activationEvents": [
        "onStartup",
        "onFrame",
        "onCommand:frameCounter.report"
    ],
    "contributes": {
        "commands": [
            { "id": "frameCounter.report", "title": "帧统计: 输出报告" }
        ]
    }
}
