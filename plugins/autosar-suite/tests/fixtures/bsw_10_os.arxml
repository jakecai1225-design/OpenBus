<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR>
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Ecuc_Os</SHORT-NAME>
      <ELEMENTS>
        <ECUC-MODULE-CONFIGURATION-VALUES>
          <SHORT-NAME>ActiveEcuC</SHORT-NAME>
          <CONTAINERS>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>Os</SHORT-NAME>
              <DEFINITION-REF>/AUTOSAR/EcucDefs/Os</DEFINITION-REF>
              <SUB-CONTAINERS>
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>OsAppMode</SHORT-NAME>
                  <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsAppMode</DEFINITION-REF>
                  <PARAMETER-VALUES>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <SHORT-NAME>OsAppModeId</SHORT-NAME>
                      <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsAppMode/OsAppModeId</DEFINITION-REF>
                      <VALUE>0</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                    <ECUC-BOOLEAN-PARAM-VALUE>
                      <SHORT-NAME>OsAppModeAutostart</SHORT-NAME>
                      <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsAppMode/OsAppModeAutostart</DEFINITION-REF>
                      <VALUE>false</VALUE>
                    </ECUC-BOOLEAN-PARAM-VALUE>
                  </PARAMETER-VALUES>
                </ECUC-CONTAINER-VALUE>
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>OsTask</SHORT-NAME>
                  <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsTask</DEFINITION-REF>
                  <PARAMETER-VALUES>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <SHORT-NAME>OsTaskPriority</SHORT-NAME>
                      <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsTask/OsTaskPriority</DEFINITION-REF>
                      <VALUE>10</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                    <ECUC-ENUMERATION-PARAM-VALUE>
                      <SHORT-NAME>OsTaskSchedule</SHORT-NAME>
                      <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsTask/OsTaskSchedule</DEFINITION-REF>
                      <VALUE>FULL</VALUE>
                    </ECUC-ENUMERATION-PARAM-VALUE>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <SHORT-NAME>OsTaskActivation</SHORT-NAME>
                      <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsTask/OsTaskActivation</DEFINITION-REF>
                      <VALUE>1</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <SHORT-NAME>OsTaskStackSize</SHORT-NAME>
                      <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsTask/OsTaskStackSize</DEFINITION-REF>
                      <VALUE>1024</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                    <ECUC-ENUMERATION-PARAM-VALUE>
                      <SHORT-NAME>OsTaskType</SHORT-NAME>
                      <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsTask/OsTaskType</DEFINITION-REF>
                      <VALUE>BASIC</VALUE>
                    </ECUC-ENUMERATION-PARAM-VALUE>
                    <ECUC-BOOLEAN-PARAM-VALUE>
                      <SHORT-NAME>OsTaskAutostart</SHORT-NAME>
                      <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsTask/OsTaskAutostart</DEFINITION-REF>
                      <VALUE>false</VALUE>
                    </ECUC-BOOLEAN-PARAM-VALUE>
                    <ECUC-TEXTUAL-PARAM-VALUE>
                      <SHORT-NAME>OsTaskAccessingApplication</SHORT-NAME>
                      <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsTask/OsTaskAccessingApplication</DEFINITION-REF>
                      <VALUE />
                    </ECUC-TEXTUAL-PARAM-VALUE>
                    <ECUC-TEXTUAL-PARAM-VALUE>
                      <SHORT-NAME>OsTaskEntry</SHORT-NAME>
                      <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsTask/OsTaskEntry</DEFINITION-REF>
                      <VALUE />
                    </ECUC-TEXTUAL-PARAM-VALUE>
                    <ECUC-REFERENCE-VALUE>
                      <SHORT-NAME>OsTaskEventRef</SHORT-NAME>
                      <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsTask/OsTaskEventRef</DEFINITION-REF>
                      <VALUE-REF />
                    </ECUC-REFERENCE-VALUE>
                    <ECUC-REFERENCE-VALUE>
                      <SHORT-NAME>OsTaskResourceRef</SHORT-NAME>
                      <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsTask/OsTaskResourceRef</DEFINITION-REF>
                      <VALUE-REF />
                    </ECUC-REFERENCE-VALUE>
                  </PARAMETER-VALUES>
                </ECUC-CONTAINER-VALUE>
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>OsOS</SHORT-NAME>
                  <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsOS</DEFINITION-REF>
                  <PARAMETER-VALUES>
                    <ECUC-BOOLEAN-PARAM-VALUE>
                      <SHORT-NAME>OsStackMonitoring</SHORT-NAME>
                      <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsOS/OsStackMonitoring</DEFINITION-REF>
                      <VALUE>false</VALUE>
                    </ECUC-BOOLEAN-PARAM-VALUE>
                    <ECUC-BOOLEAN-PARAM-VALUE>
                      <SHORT-NAME>OsStatus</SHORT-NAME>
                      <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsOS/OsStatus</DEFINITION-REF>
                      <VALUE>false</VALUE>
                    </ECUC-BOOLEAN-PARAM-VALUE>
                    <ECUC-BOOLEAN-PARAM-VALUE>
                      <SHORT-NAME>OsUseGetServiceId</SHORT-NAME>
                      <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsOS/OsUseGetServiceId</DEFINITION-REF>
                      <VALUE>false</VALUE>
                    </ECUC-BOOLEAN-PARAM-VALUE>
                    <ECUC-BOOLEAN-PARAM-VALUE>
                      <SHORT-NAME>OsUseParameterAccess</SHORT-NAME>
                      <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsOS/OsUseParameterAccess</DEFINITION-REF>
                      <VALUE>false</VALUE>
                    </ECUC-BOOLEAN-PARAM-VALUE>
                    <ECUC-BOOLEAN-PARAM-VALUE>
                      <SHORT-NAME>OsUseResScheduler</SHORT-NAME>
                      <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsOS/OsUseResScheduler</DEFINITION-REF>
                      <VALUE>false</VALUE>
                    </ECUC-BOOLEAN-PARAM-VALUE>
                    <ECUC-ENUMERATION-PARAM-VALUE>
                      <SHORT-NAME>OsScalabilityClass</SHORT-NAME>
                      <DEFINITION-REF>/AUTOSAR/EcucDefs/Os/OsOS/OsScalabilityClass</DEFINITION-REF>
                      <VALUE>SC1</VALUE>
                    </ECUC-ENUMERATION-PARAM-VALUE>
                  </PARAMETER-VALUES>
                </ECUC-CONTAINER-VALUE>
              </SUB-CONTAINERS>
            </ECUC-CONTAINER-VALUE>
          </CONTAINERS>
        </ECUC-MODULE-CONFIGURATION-VALUES>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>