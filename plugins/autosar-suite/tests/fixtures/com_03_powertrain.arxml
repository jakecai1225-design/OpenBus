<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR>
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Powertrain</SHORT-NAME>
      <ELEMENTS>
        <I-SIGNAL>
          <SHORT-NAME>SigA</SHORT-NAME>
          <LENGTH>8</LENGTH>
          <FACTOR>1.0</FACTOR>
          <OFFSET>0.0</OFFSET>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>SigB</SHORT-NAME>
          <LENGTH>16</LENGTH>
          <FACTOR>0.1</FACTOR>
          <OFFSET>0.0</OFFSET>
          <UNIT>km/h</UNIT>
        </I-SIGNAL>
        <I-SIGNAL-I-PDU>
          <SHORT-NAME>PowertrainPdu</SHORT-NAME>
          <LENGTH>8</LENGTH>
          <I-SIGNAL-TO-PDU-MAPPINGS>
            <I-SIGNAL-TO-PDU-MAPPING>
              <SHORT-NAME>SigAMap0</SHORT-NAME>
              <I-SIGNAL-REF>/Signals/SigA</I-SIGNAL-REF>
              <START-POSITION>0</START-POSITION>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
            </I-SIGNAL-TO-PDU-MAPPING>
            <I-SIGNAL-TO-PDU-MAPPING>
              <SHORT-NAME>SigBMap1</SHORT-NAME>
              <I-SIGNAL-REF>/Signals/SigB</I-SIGNAL-REF>
              <START-POSITION>8</START-POSITION>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
            </I-SIGNAL-TO-PDU-MAPPING>
          </I-SIGNAL-TO-PDU-MAPPINGS>
        </I-SIGNAL-I-PDU>
        <CAN-FRAME>
          <SHORT-NAME>PowertrainPduFrame</SHORT-NAME>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <PDU-REF>/Pdus/PowertrainPdu</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME-TRIGGERING>
          <SHORT-NAME>PowertrainPduTrig</SHORT-NAME>
          <IDENTIFIER>768</IDENTIFIER>
          <FRAME-REF>/Frames/PowertrainPduFrame</FRAME-REF>
        </CAN-FRAME-TRIGGERING>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>VendorExtra3</SHORT-NAME>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>