<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR>
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Body</SHORT-NAME>
      <ELEMENTS>
        <ECU-INSTANCE>
          <SHORT-NAME>BodyECU</SHORT-NAME>
        </ECU-INSTANCE>
        <I-SIGNAL>
          <SHORT-NAME>VehicleSpeed</SHORT-NAME>
          <LENGTH>16</LENGTH>
          <FACTOR>0.01</FACTOR>
          <OFFSET>0</OFFSET>
          <UNIT>km/h</UNIT>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>EngineRpm</SHORT-NAME>
          <LENGTH>16</LENGTH>
          <FACTOR>0.125</FACTOR>
          <OFFSET>0</OFFSET>
          <UNIT>rpm</UNIT>
        </I-SIGNAL>
        <I-SIGNAL-I-PDU>
          <SHORT-NAME>BodyStatus</SHORT-NAME>
          <LENGTH>8</LENGTH>
          <I-SIGNAL-TO-PDU-MAPPINGS>
            <I-SIGNAL-TO-PDU-MAPPING>
              <SHORT-NAME>VehicleSpeedMap</SHORT-NAME>
              <I-SIGNAL-REF>/Signals/VehicleSpeed</I-SIGNAL-REF>
              <START-POSITION>7</START-POSITION>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-FIRST</PACKING-BYTE-ORDER>
            </I-SIGNAL-TO-PDU-MAPPING>
            <I-SIGNAL-TO-PDU-MAPPING>
              <SHORT-NAME>EngineRpmMap</SHORT-NAME>
              <I-SIGNAL-REF>/Signals/EngineRpm</I-SIGNAL-REF>
              <START-POSITION>16</START-POSITION>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
            </I-SIGNAL-TO-PDU-MAPPING>
          </I-SIGNAL-TO-PDU-MAPPINGS>
        </I-SIGNAL-I-PDU>
        <CAN-FRAME>
          <SHORT-NAME>BodyStatusFrame</SHORT-NAME>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <PDU-REF>/Pdus/BodyStatus</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME-TRIGGERING>
          <SHORT-NAME>BodyStatusTrig</SHORT-NAME>
          <IDENTIFIER>256</IDENTIFIER>
          <FRAME-REF>/Frames/BodyStatusFrame</FRAME-REF>
        </CAN-FRAME-TRIGGERING>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
