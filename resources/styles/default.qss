/* ============================================================
   openbus 样式表 — VS Code 风格 (扁平·简洁·统一)
   ============================================================ */

/* ---- 全局 ---- */
QMainWindow {
    background-color: #f8f8f8;
}

QWidget {
    font-size: 12px;
}

/* ---- 菜单栏 (兼做标题栏) ---- */
QMenuBar {
    background-color: #2D2D2D;
    color: #e0e0e0;
    border: none;
    padding: 1px;
    min-height: 28px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 12px;
    border-radius: 2px;
}

QMenuBar::item:selected {
    background-color: #3D3D3D;
}

QMenuBar::item:pressed {
    background-color: #0066b8;
}

QMenu {
    background-color: #2D2D2D;
    color: #e0e0e0;
    border: 1px solid #1a1a1a;
    padding: 4px;
}

QMenu::item {
    padding: 5px 24px 5px 20px;
    border-radius: 2px;
}

QMenu::item:selected {
    background-color: #0066b8;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #555;
    margin: 4px 8px;
}

/* ---- DockWidget ---- */
QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #ececec;
    padding: 5px 10px;
    border: none;
    border-bottom: 1px solid #e4e4e4;
}

/* ---- Panel titles (统一风格) ---- */
#CollapsibleTitle {
    background-color: #ececec;
    color: #6c6c6c;
    font-weight: bold;
    font-size: 11px;
    padding: 5px 10px;
    border: none;
    border-bottom: 1px solid #e4e4e4;
}

#CollapsibleTitle:hover {
    background-color: #eaeaea;
}

/* ---- DockPanelTitle (FrameInfo/HexDump) ---- */
#DockPanelTitle {
    background-color: #ececec;
    color: #6c6c6c;
    font-weight: bold;
    font-size: 11px;
    padding: 5px 10px;
    border: none;
    border-bottom: 1px solid #e4e4e4;
}

/* ---- ProjectList ---- */
#ProjectList {
    background-color: #f3f3f3;
    border: none;
    outline: none;
    font-size: 12px;
}

#ProjectList::item {
    padding: 4px 8px;
    min-height: 22px;
}

#ProjectList::item:hover {
    background-color: #eaeaea;
}

#ProjectList::item:selected {
    background-color: #d6ebff;
    color: #000;
}

/* ---- ActivityBar ---- */
#ActivityBar QToolButton {
    background-color: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

#ActivityBar QToolButton:hover {
    background-color: #3d3d3d;
}

#ActivityBar QToolButton:checked {
    border-left: 2px solid #0066b8;
    color: #ffffff;
}

/* ---- SideBar 面板 ---- */
#SidePanelTitle {
    background-color: #ececec;
    color: #6c6c6c;
    font-weight: bold;
    font-size: 11px;
    padding: 5px 10px;
    border-bottom: 1px solid #e4e4e4;
}

QTreeWidget {
    background-color: #f3f3f3;
    border: none;
    outline: none;
    font-size: 12px;
}

QTreeWidget::item {
    padding: 2px 4px;
    min-height: 20px;
}

QTreeWidget::item:hover {
    background-color: #eaeaea;
}

QTreeWidget::item:selected {
    background-color: #d6ebff;
    color: #000;
}

QTreeWidget::branch:has-siblings:!adjoins-item {
    background: transparent;
}

QListWidget {
    background-color: #f3f3f3;
    border: none;
    outline: none;
    font-size: 12px;
}

QListWidget::item {
    padding: 3px 6px;
    min-height: 20px;
}

QListWidget::item:hover {
    background-color: #eaeaea;
}

QListWidget::item:selected {
    background-color: #d6ebff;
}

/* ---- 工具栏 ---- */
QToolBar {
    background-color: #ececec;
    border: none;
    border-bottom: 1px solid #e4e4e4;
    padding: 2px;
    spacing: 2px;
}

QToolBar QToolButton {
    padding: 3px 8px;
    margin: 1px;
    border-radius: 2px;
    background-color: transparent;
    color: #3b3b3b;
    font-size: 12px;
}

QToolBar QToolButton:hover {
    background-color: #dcdcdc;
}

QToolBar QToolButton:checked {
    background-color: #dcdcdc;
}

QToolBar QLabel {
    color: #6c6c6c;
    font-size: 11px;
    padding: 0 4px;
}

/* ---- 主区域标签页 ---- */
QTabWidget::pane {
    border: none;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #ececec;
    color: #6c6c6c;
    padding: 5px 12px;
    border: none;
    border-bottom: 1px solid #e4e4e4;
    font-size: 12px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #3b3b3b;
    border-bottom: 2px solid #0066b8;
}

QTabBar::tab:hover:!selected {
    background-color: #dcdcdc;
}

#BottomPanel::pane {
    border-top: 1px solid #e4e4e4;
    background-color: #ffffff;
}

#BottomPanel QTabBar::tab {
    padding: 4px 12px;
    font-size: 11px;
    border-bottom: none;
    border-top: 2px solid transparent;
}

#BottomPanel QTabBar::tab:selected {
    border-top: 2px solid #0066b8;
    border-bottom: none;
}

#RightPanel::pane {
    border: none;
    border-left: 1px solid #e4e4e4;
    background-color: #f8f8f8;
}

#RightPanel QTabBar::tab {
    padding: 4px 12px;
    font-size: 11px;
}

/* ---- 过滤栏 ---- */
QLineEdit {
    border: 1px solid #e4e4e4;
    border-radius: 2px;
    padding: 4px 6px;
    background-color: #ffffff;
    font-size: 12px;
    selection-background-color: #0066b8;
}

QLineEdit:focus {
    border: 1px solid #0066b8;
}

QPushButton {
    background-color: #ececec;
    color: #3b3b3b;
    border: 1px solid #e4e4e4;
    border-radius: 2px;
    padding: 5px 12px;
    font-size: 12px;
}

QPushButton:hover {
    background-color: #dcdcdc;
    border: 1px solid #0066b8;
}

QPushButton:pressed {
    background-color: #cccccc;
}

QPushButton:disabled {
    background-color: #f0f0f0;
    color: #b0b0b0;
    border: 1px solid #e4e4e4;
}

/* ---- Trace 表格 ---- */
QTableView {
    background-color: #ffffff;
    alternate-background-color: #fafafa;
    gridline-color: #f0f0f0;
    selection-background-color: #d6ebff;
    selection-color: #000000;
    border: none;
    font-size: 12px;
}

QTableView::item {
    padding: 1px 4px;
    min-height: 18px;
}

QTableView::item:selected {
    background-color: #d6ebff;
}

QHeaderView::section {
    background-color: #f0f0f0;
    color: #6c6c6c;
    padding: 3px 6px;
    border: none;
    border-right: 1px solid #e4e4e4;
    border-bottom: 1px solid #e4e4e4;
    font-size: 12px;
}

QHeaderView::section:hover {
    background-color: #e8e8e8;
}

/* ---- 分割器 ---- */
QSplitter::handle {
    background-color: #ececec;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:hover {
    background-color: #0066b8;
}

/* ---- 滑块 ---- */
QSlider::groove:horizontal {
    border: 1px solid #e4e4e4;
    height: 4px;
    background: #ececec;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #0066b8;
    border: 1px solid #005a9e;
    width: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background: #1f7ad3;
}

/* ---- 下拉框 ---- */
QComboBox {
    border: 1px solid #e4e4e4;
    border-radius: 2px;
    padding: 3px 6px;
    background-color: #ffffff;
    font-size: 12px;
}

QComboBox:hover {
    border: 1px solid #0066b8;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    border: 1px solid #e4e4e4;
    background-color: #ffffff;
    selection-background-color: #d6ebff;
    selection-color: #000000;
}

/* ---- 状态栏 ---- */
QStatusBar {
    background-color: #0066b8;
    color: #ffffff;
    border-top: 1px solid #005a9e;
    font-size: 11px;
}

QStatusBar QLabel {
    padding: 1px 8px;
}

/* ---- 复选框 ---- */
QCheckBox {
    color: #333;
    font-size: 12px;
    spacing: 6px;
}

/* ---- GroupBox ---- */
QGroupBox {
    border: 1px solid #e4e4e4;
    border-radius: 3px;
    margin-top: 10px;
    padding-top: 6px;
    font-size: 12px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}

/* ---- DbcDetailTab 标题 ---- */
#DbcDetailTitle {
    background-color: #ececec;
    color: #6c6c6c;
    font-weight: bold;
    font-size: 11px;
    padding: 5px 10px;
    border-bottom: 1px solid #e4e4e4;
}

/* ---- 侧边栏通用控件 ---- */
#SidePanelSubTitle {
    font-weight: bold;
    padding: 4px 8px;
    color: #6c6c6c;
    font-size: 11px;
}

#SidePanelButton {
    text-align: left;
    padding: 8px;
    font-size: 12px;
}

#SidePanelHint {
    padding: 8px;
    color: #6c6c6c;
    font-size: 11px;
}

#SidePanelInfo {
    color: #6c6c6c;
    font-size: 11px;
    padding: 4px;
}

#DimLabel {
    color: #6c6c6c;
    font-size: 11px;
}

#SectionLabel {
    font-size: 14px;
    font-weight: bold;
    padding: 4px;
    color: #3b3b3b;
}

#StatusDim {
    color: #6c6c6c;
    font-size: 12px;
    padding: 4px;
}

#StatusWarn {
    color: #d68a1c;
    font-size: 12px;
    padding: 4px;
}

#StatusOk {
    color: #2d8a3e;
    font-size: 12px;
    padding: 4px;
}

#StatusRec {
    color: #d63232;
    font-size: 12px;
}

#StatusSuccess {
    padding: 4px;
    background-color: #e8f5e8;
    color: #2d8a3e;
}

#StatusError {
    padding: 4px;
    background-color: #fbeaea;
    color: #d63232;
}

#NmtStatus {
    padding: 4px;
    background-color: #ececec;
    color: #6c6c6c;
}

/* ---- DbcDetailTab ---- */
#DbcDetailPageTitle {
    font-weight: bold;
    font-size: 13px;
    color: #3b3b3b;
}

#DbcDetailInfo {
    color: #6c6c6c;
}

#DbcDetailComment {
    color: #6c6c6c;
    font-style: italic;
}

#DbcDetailPlaceholder {
    color: #6c6c6c;
    font-size: 13px;
}

/* ---- 对话框 ---- */
QDialog {
    background-color: #f8f8f8;
}

QTextBrowser {
    background-color: #ffffff;
    color: #3b3b3b;
    border: 1px solid #e4e4e4;
    font-size: 12px;
}

QDialogButtonBox QPushButton {
    min-width: 70px;
}

/* ---- QSpinBox ---- */
QSpinBox {
    border: 1px solid #e4e4e4;
    border-radius: 2px;
    padding: 3px 4px;
    background-color: #ffffff;
    font-size: 12px;
}

/* ---- 文本编辑 (内容区用浅色主题) ---- */
QPlainTextEdit {
    background-color: #f8f8f8;
    color: #3b3b3b;
    border: none;
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}

/* 终端面板保持深色主题 */
#TerminalOutput {
    background-color: #1e1e1e;
    color: #d4d4d4;
}

/* ---- 表格（Problems/Properties/Statistics） ---- */
QTableWidget {
    background-color: #f8f8f8;
    alternate-background-color: #fafafa;
    border: none;
    gridline-color: #e4e4e4;
    font-size: 12px;
}

QTableWidget::item {
    padding: 2px 6px;
}

QTableWidget::item:selected {
    background-color: #d6ebff;
}

/* ---- 滚动条 ---- */
QScrollBar:vertical {
    border: none;
    background: #f8f8f8;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #c8c8c8;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #a0a0a0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    border: none;
    background: #f8f8f8;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #c8c8c8;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #a0a0a0;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---- 窗口控制按钮 (最小化/最大化/关闭) ---- */
#WindowButtons {
    background-color: transparent;
}

#WinMinBtn, #WinMaxBtn {
    background-color: transparent;
    color: #e0e0e0;
    border: none;
    font-size: 13px;
}

#WinMinBtn:hover, #WinMaxBtn:hover {
    background-color: #3D3D3D;
}

#WinMinBtn:pressed, #WinMaxBtn:pressed {
    background-color: #0066b8;
}

#WinCloseBtn {
    background-color: transparent;
    color: #e0e0e0;
    border: none;
    font-size: 13px;
}

#WinCloseBtn:hover {
    background-color: #e81123;
    color: #ffffff;
}

#WinCloseBtn:pressed {
    background-color: #f1707a;
    color: #ffffff;
}
