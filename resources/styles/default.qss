/* ============================================================
   sin 样式表 — VS Code 风格
   ============================================================ */

/* ---- 全局 ---- */
QMainWindow {
    background-color: #f0f0f0;
}

QWidget {
    font-size: 12px;
}

/* ---- 菜单栏 (兼做标题栏) ---- */
QMenuBar {
    background-color: #2D2D2D;
    color: #e0e0e0;
    border: none;
    padding: 1px;
    min-height: 28px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 12px;
    border-radius: 2px;
}

QMenuBar::item:selected {
    background-color: #3D3D3D;
}

QMenuBar::item:pressed {
    background-color: #4a90d9;
}

QMenu {
    background-color: #2D2D2D;
    color: #e0e0e0;
    border: 1px solid #1a1a1a;
    padding: 4px;
}

QMenu::item {
    padding: 5px 24px 5px 20px;
    border-radius: 2px;
}

QMenu::item:selected {
    background-color: #4a90d9;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #555;
    margin: 4px 8px;
}

/* ---- DockWidget ---- */
QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #d0d0d0;
    padding: 2px 4px;
    border: none;
    border-bottom: 1px solid #b0b0b0;
}

/* ---- CollapsibleSection ---- */
#CollapsibleTitle {
    background-color: #e0e0e0;
    color: #333;
    font-weight: bold;
    font-size: 11px;
    padding: 4px 8px;
    border: none;
    border-bottom: 1px solid #c0c0c0;
}

#CollapsibleTitle:hover {
    background-color: #d0d0d0;
}

/* ---- DockPanelTitle (FrameInfo/HexDump) ---- */
#DockPanelTitle {
    background-color: #e0e0e0;
    color: #555;
    font-weight: bold;
    font-size: 11px;
    padding: 4px 6px;
    border: none;
    border-bottom: 1px solid #c0c0c0;
}

/* ---- ProjectList ---- */
#ProjectList {
    background-color: #f5f5f5;
    border: none;
    outline: none;
    font-size: 12px;
}

#ProjectList::item {
    padding: 4px 8px;
    min-height: 22px;
}

#ProjectList::item:hover {
    background-color: #e0e0e0;
}

#ProjectList::item:selected {
    background-color: #c5d9f1;
    color: #000;
}

/* ---- ActivityBar ---- */
#ActivityBar QToolButton {
    background-color: transparent;
    border: none;
    color: #b0b0b0;
    font-size: 18px;
    padding: 0;
    margin: 0;
}

#ActivityBar QToolButton:hover {
    background-color: #3d3d3d;
}

#ActivityBar QToolButton:checked {
    border-left: 2px solid #4a90d9;
    color: #ffffff;
}

/* ---- SideBar 面板 ---- */
#SidePanelTitle {
    background-color: #e0e0e0;
    color: #333;
    font-weight: bold;
    font-size: 11px;
    padding: 6px 10px;
    border-bottom: 1px solid #c0c0c0;
}

QTreeWidget {
    background-color: #f5f5f5;
    border: none;
    outline: none;
    font-size: 12px;
}

QTreeWidget::item {
    padding: 2px 4px;
    min-height: 20px;
}

QTreeWidget::item:hover {
    background-color: #e0e0e0;
}

QTreeWidget::item:selected {
    background-color: #c5d9f1;
    color: #000;
}

QTreeWidget::branch:has-siblings:!adjoins-item {
    background: transparent;
}

QListWidget {
    background-color: #f5f5f5;
    border: none;
    outline: none;
    font-size: 12px;
}

QListWidget::item {
    padding: 3px 6px;
    min-height: 20px;
}

QListWidget::item:hover {
    background-color: #e0e0e0;
}

QListWidget::item:selected {
    background-color: #c5d9f1;
}

/* ---- 工具栏 ---- */
QToolBar {
    background-color: #e0e0e0;
    border: none;
    border-bottom: 1px solid #c0c0c0;
    padding: 3px;
    spacing: 3px;
}

QToolBar QToolButton {
    padding: 4px 8px;
    margin: 1px;
    border-radius: 3px;
    background-color: transparent;
    color: #333;
    font-size: 12px;
}

QToolBar QToolButton:hover {
    background-color: #d0d0d0;
}

QToolBar QToolButton:checked {
    background-color: #c0c0c0;
    border: 1px solid #888;
}

QToolBar QLabel {
    color: #555;
    font-size: 11px;
    padding: 0 4px;
}

/* ---- 主区域标签页 ---- */
QTabWidget::pane {
    border: none;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #e0e0e0;
    color: #666;
    padding: 6px 14px;
    border: none;
    border-right: 1px solid #c0c0c0;
    border-bottom: 1px solid #c0c0c0;
    font-size: 12px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #333;
    border-bottom: 2px solid #4a90d9;
}

QTabBar::tab:hover:!selected {
    background-color: #d8d8d8;
}

#BottomPanel::pane {
    border-top: 1px solid #c0c0c0;
    background-color: #ffffff;
}

#BottomPanel QTabBar::tab {
    padding: 4px 12px;
    font-size: 11px;
    border-bottom: none;
    border-top: 2px solid transparent;
}

#BottomPanel QTabBar::tab:selected {
    border-top: 2px solid #4a90d9;
    border-bottom: none;
}

#RightPanel::pane {
    border: none;
    border-left: 1px solid #c0c0c0;
    background-color: #f8f8f8;
}

#RightPanel QTabBar::tab {
    padding: 4px 10px;
    font-size: 11px;
}

/* ---- 过滤栏 ---- */
QLineEdit {
    border: 1px solid #b0b0b0;
    border-radius: 3px;
    padding: 3px 6px;
    background-color: #ffffff;
    font-size: 12px;
    selection-background-color: #4a90d9;
}

QLineEdit:focus {
    border: 1px solid #4a90d9;
}

QPushButton {
    background-color: #e0e0e0;
    color: #333;
    border: 1px solid #b0b0b0;
    border-radius: 3px;
    padding: 4px 10px;
    font-size: 12px;
}

QPushButton:hover {
    background-color: #d0d0d0;
    border: 1px solid #888;
}

QPushButton:pressed {
    background-color: #c0c0c0;
}

QPushButton:disabled {
    background-color: #eee;
    color: #aaa;
    border: 1px solid #ddd;
}

/* ---- Trace 表格 ---- */
QTableView {
    background-color: #ffffff;
    alternate-background-color: #f7f7f7;
    gridline-color: #e8e8e8;
    selection-background-color: #c5d9f1;
    selection-color: #000000;
    border: none;
    font-size: 12px;
}

QTableView::item {
    padding: 1px 4px;
    min-height: 18px;
}

QTableView::item:selected {
    background-color: #c5d9f1;
}

QHeaderView::section {
    background-color: #d8d8d8;
    color: #333;
    padding: 3px 6px;
    border: none;
    border-right: 1px solid #c0c0c0;
    border-bottom: 1px solid #c0c0c0;
    font-size: 12px;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #c8c8c8;
}

/* ---- 分割器 ---- */
QSplitter::handle {
    background-color: #d0d0d0;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:hover {
    background-color: #4a90d9;
}

/* ---- 滑块 ---- */
QSlider::groove:horizontal {
    border: 1px solid #b0b0b0;
    height: 4px;
    background: #e0e0e0;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #4a90d9;
    border: 1px solid #3a7fc9;
    width: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background: #5a9ee8;
}

/* ---- 下拉框 ---- */
QComboBox {
    border: 1px solid #b0b0b0;
    border-radius: 3px;
    padding: 2px 6px;
    background-color: #ffffff;
    font-size: 12px;
}

QComboBox:hover {
    border: 1px solid #888;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    border: 1px solid #b0b0b0;
    background-color: #ffffff;
    selection-background-color: #c5d9f1;
    selection-color: #000000;
}

/* ---- 状态栏 ---- */
QStatusBar {
    background-color: #4a90d9;
    color: #ffffff;
    border-top: 1px solid #3a7fc9;
    font-size: 11px;
}

QStatusBar QLabel {
    padding: 1px 8px;
}

/* ---- 复选框 ---- */
QCheckBox {
    color: #333;
    font-size: 12px;
    spacing: 6px;
}

/* ---- 对话框 ---- */
QDialog {
    background-color: #f0f0f0;
}

QDialogButtonBox QPushButton {
    min-width: 70px;
}

/* ---- QSpinBox ---- */
QSpinBox {
    border: 1px solid #b0b0b0;
    border-radius: 3px;
    padding: 2px 4px;
    background-color: #ffffff;
    font-size: 12px;
}

/* ---- 文本编辑 ---- */
QPlainTextEdit {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: none;
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}

/* ---- 表格（Problems/Properties/Statistics） ---- */
QTableWidget {
    background-color: #f8f8f8;
    alternate-background-color: #f0f0f0;
    border: none;
    gridline-color: #e0e0e0;
    font-size: 12px;
}

QTableWidget::item {
    padding: 2px 6px;
}

QTableWidget::item:selected {
    background-color: #c5d9f1;
}

/* ---- 滚动条 ---- */
QScrollBar:vertical {
    border: none;
    background: #f0f0f0;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #c0c0c0;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #a0a0a0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    border: none;
    background: #f0f0f0;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #c0c0c0;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #a0a0a0;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---- 窗口控制按钮 (最小化/最大化/关闭) ---- */
#WindowButtons {
    background-color: transparent;
}

#WinMinBtn, #WinMaxBtn {
    background-color: transparent;
    color: #e0e0e0;
    border: none;
    font-size: 13px;
}

#WinMinBtn:hover, #WinMaxBtn:hover {
    background-color: #3D3D3D;
}

#WinMinBtn:pressed, #WinMaxBtn:pressed {
    background-color: #4a90d9;
}

#WinCloseBtn {
    background-color: transparent;
    color: #e0e0e0;
    border: none;
    font-size: 13px;
}

#WinCloseBtn:hover {
    background-color: #e81123;
    color: #ffffff;
}

#WinCloseBtn:pressed {
    background-color: #f1707a;
    color: #ffffff;
}
