/* ============================================================
   openbus QSS 模板 — 使用 @变量 占位，由 ThemeManager 运行时替换
   修样式只需改本文件 + 重启，无需重新编译
   ============================================================ */

/* ---- 全局 ---- */
* { font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif; }
QMainWindow { background-color: @windowBg; }
QWidget { font-size: 13px; color: @text; }

/* ---- 菜单栏 (兼标题栏, 32px) ---- */
QMenuBar { background-color: @barBg; color: @barFg; border: none; padding: 0; min-height: 32px; }
QMenuBar::item { background: transparent; padding: 0 12px; margin: 4px 0; border-radius: 0; }
QMenuBar::item:selected { background-color: @barHover; }
QMenuBar::item:pressed { background-color: @accent; }

QMenu { background-color: @contentBg; color: @text; border: 1px solid @border; padding: 6px 0; }
QMenu::item { padding: 6px 32px 6px 24px; border-radius: 0; }
QMenu::item:selected { background-color: @accent; color: #ffffff; }
QMenu::separator { height: 1px; background-color: @borderDim; margin: 4px 8px; }

/* ---- DockWidget ---- */
QDockWidget { titlebar-close-icon: none; titlebar-normal-icon: none; background-color: @sidebarBg; }
QDockWidget::title { background-color: @panelBg; padding: 0; border: none; border-bottom: 1px solid @border; }
#LeftContainer { background-color: @sidebarBg; border-right: 1px solid @border; }
#LeftDock { background-color: @sidebarBg; border: none; }
#BottomDock { background-color: @sidebarBg; border: none; }
#RightDock { background-color: @sidebarBg; border: none; }
#SideBar { background-color: @sidebarBg; }
SidePanel { background-color: @sidebarBg; }

/* ---- 面板标题 (统一: 30px 高) ---- */
#CollapsibleTitle, #DockPanelTitle, #SidePanelTitle, #DbcDetailTitle {
    background-color: @panelBg; color: @textDim; font-weight: 600; font-size: 12px;
    padding: 0 12px; min-height: 30px; border: none; border-bottom: 1px solid @borderDim;
}
#CollapsibleTitle:hover { background-color: @hoverBg; }

/* ---- 侧边栏通用控件 ---- */
#SidePanelSubTitle { font-weight: 600; padding: 6px 12px; color: @textDim; font-size: 12px; }
#SidePanelButton { text-align: left; padding: 8px 12px; font-size: 13px; }

/* 侧栏底部动作按钮（VS Code 风格：扁平无框，悬停高亮；如设备面板「扫描设备」） */
#SidePanelFooterButton {
    background-color: transparent; color: @text;
    border: none; border-radius: 3px;
    padding: 6px 12px; font-size: 13px; text-align: left;
}
#SidePanelFooterButton:hover { background-color: @hoverBg; border: none; }
#SidePanelFooterButton:pressed { background-color: @buttonPress; }
#SidePanelFooterButton:disabled { color: @buttonDisabledText; background-color: transparent; }
#SidePanelHint { padding: 8px 12px; color: @textDim; font-size: 12px; }
#SidePanelInfo { color: @textDim; font-size: 12px; padding: 4px 12px; }
#DimLabel { color: @textDim; font-size: 12px; }
#SectionLabel { font-size: 14px; font-weight: 600; padding: 6px 0; color: @text; }
#StatusDim { color: @textDim; font-size: 12px; padding: 4px; }
#StatusWarn { color: #d68a1c; font-size: 12px; padding: 4px; }
#StatusOk { color: #2d8a3e; font-size: 12px; padding: 4px; }
#StatusRec { color: #d63232; font-size: 12px; }
#StatusSuccess { padding: 4px; background-color: #e8f5e8; color: #2d8a3e; }
#StatusError { padding: 4px; background-color: #fbeaea; color: #d63232; }
#NmtStatus { padding: 4px; background-color: @panelBg; color: @textDim; }

/* ---- DbcDetailTab ---- */
#DbcDetailPageTitle { font-weight: 600; font-size: 14px; color: @text; padding: 2px 0; }
#DbcDetailInfo { color: @textDim; padding: 1px 0; }
#DbcDetailComment { color: @textDim; font-style: italic; padding: 1px 0; }
#DbcDetailPlaceholder { color: @textDim; font-size: 14px; }

/* ---- 列表 / 树 (VS Code Explorer 风格: 紧凑行高 + 圆角悬停/选中) ---- */
#ProjectList { background-color: @sidebarBg; border: none; outline: none; font-size: 13px; }
#ProjectList::item { padding: 4px 12px; min-height: 24px; border: none; border-radius: 4px; }
#ProjectList::item:hover { background-color: @hoverBg; }
#ProjectList::item:selected { background-color: @selectionBg; color: @text; }

QTreeWidget, QTreeView {
    background-color: @sidebarBg; border: none; outline: none; font-size: 13px;
}
QTreeWidget::item, QTreeView::item { padding: 3px 6px; min-height: 24px; border: none; border-radius: 4px; }
QTreeWidget::item:hover, QTreeView::item:hover { background-color: @hoverBg; }
QTreeWidget::item:selected, QTreeView::item:selected { background-color: @selectionBg; color: @text; }
QTreeWidget::item:alternate, QTreeView::item:alternate { background-color: @altRowBg; }

/* 内容区树 (DBC 信号树等): 带淡边框形成边界 */
#ContentTree {
    background-color: @contentBg; border: 1px solid @border; border-radius: 4px;
    outline: none; font-size: 12px;
}

/* 树形分支: VS Code 风格展开箭头 + 缩进参考线 (主题色图标由 ThemeManager 生成注入)
   注意顺序: 参考线规则在前，箭头规则在后 (箭头位置优先) */
QTreeWidget::branch, QTreeView::branch { background: transparent; }
QTreeWidget::branch:has-siblings, QTreeView::branch:has-siblings { image: url("@treeGuide"); }
QTreeWidget::branch:has-children:closed, QTreeView::branch:has-children:closed {
    image: url("@treeChevronRight");
}
QTreeWidget::branch:has-children:open, QTreeView::branch:has-children:open {
    image: url("@treeChevronDown");
}

QListWidget { background-color: @sidebarBg; border: none; outline: none; font-size: 13px; }
QListWidget::item { padding: 4px 12px; min-height: 24px; border: none; border-radius: 4px; }
QListWidget::item:hover { background-color: @hoverBg; }
QListWidget::item:selected { background-color: @selectionBg; }

/* ---- ActivityBar (50px 宽) ---- */
#ActivityBar { background-color: @activityBarBg; }
#ActivityBar QToolButton { background: transparent; border: none; padding: 0; margin: 0; color: @activityBarFg; }
#ActivityBar QToolButton:hover { background-color: @activityBarHover; }
#ActivityBar QToolButton:checked { border-left: 3px solid @accent; }

/* ---- 工具栏 ---- */
QToolBar { background-color: @panelBg; border: none; border-bottom: 1px solid @borderDim; padding: 3px 6px; spacing: 3px; }
QToolBar QToolButton { padding: 5px 10px; margin: 0; border: none; border-radius: 0; background: transparent; color: @text; font-size: 13px; }
QToolBar QToolButton:hover { background-color: @hoverBg; }
QToolBar QToolButton:checked { background-color: @hoverBg; }
QToolBar QLabel { color: @textDim; font-size: 12px; padding: 0 6px; }

/* 带下拉菜单的 QToolButton 右侧小箭头（原生指示器不随主题） */
QToolButton::menu-indicator {
    image: url(@spinDown);
    subcontrol-origin: padding; subcontrol-position: right center;
    width: 10px; height: 10px;
}

/* ---- 标签页 — 主区域 (VS Code 风格: 淡边框 + 选中顶部无边界) ---- */
QTabWidget::pane { border: 1px solid @border; border-top: none; background-color: @contentBg; }
QTabBar { qproperty-drawBase: 0; }
QTabBar::tab {
    background-color: @tabBg; color: @textDim; padding: 6px 14px; min-height: 26px;
    border: 1px solid transparent; border-bottom: 1px solid @border;
    border-top-left-radius: 3px; border-top-right-radius: 3px; font-size: 13px; margin: 0;
}
QTabBar::tab:hover:!selected { background-color: @tabHoverBg; color: @text; }
QTabBar::tab:selected {
    background-color: @tabActiveBg; color: @text;
    border: 1px solid @border; border-bottom: 3px solid @accent;
}
QTabBar::close-button {
    image: url(@tabClose);
    subcontrol-position: right;
    background: transparent; border: none; border-radius: 3px;
    margin: 2px;
}
QTabBar::close-button:hover { image: url(@tabCloseHover); background-color: @hoverBg; }
QTabBar::close-button:pressed { background-color: @buttonPress; }

/* 自定义关闭按钮（SplitEditorArea 换装为 QToolButton）: VS Code 中性悬停 */
QTabBar QToolButton { background: transparent; border: none; border-radius: 3px; }
QTabBar QToolButton:hover { background-color: @hoverBg; }

/* ---- 底部面板标签 (28px) ---- */
#BottomPanel { background-color: @sidebarBg; }
#BottomPanel::pane {
    border: 1px solid @border; border-top: 1px solid @border;
    border-left: none; border-right: none; border-bottom: none;
    background-color: @sidebarBg;
}
#BottomPanel QTabBar::tab {
    padding: 5px 14px; min-height: 20px; font-size: 12px;
    border-bottom: none; border-top: 2px solid transparent; margin: 0;
}
#BottomPanel QTabBar::tab:selected { border-top: 2px solid @accent; border-bottom: none; color: @text; }
#BottomPanel QTabBar::tab:hover:!selected { color: @text; }

/* ---- 右侧面板标签 (28px) ---- */
#RightPanel::pane {
    border: none; border-left: 1px solid @border; background-color: @sidebarBg;
}
#RightPanel QTabBar::tab {
    padding: 5px 14px; min-height: 20px; font-size: 12px;
    border-bottom: none; border-top: 2px solid transparent; margin: 0;
}
#RightPanel QTabBar::tab:selected { border-top: 2px solid @accent; border-bottom: none; color: @text; }
#RightPanel QTabBar::tab:hover:!selected { color: @text; }

/* ---- 输入框 ---- */
QLineEdit {
    border: 1px solid @borderDim; border-radius: 3px; padding: 5px 8px;
    background-color: @contentBg; font-size: 13px; min-height: 20px;
    selection-background-color: @accent; selection-color: #ffffff;
}
QLineEdit:focus { border: 1px solid @accent; }
QLineEdit:hover { border: 1px solid @border; }
QLineEdit:disabled { background-color: @buttonDisabledBg; color: @buttonDisabledText; }

/* ---- 文本编辑 ---- */
QTextEdit {
    background-color: @contentBg; color: @text; border: 1px solid @borderDim; border-radius: 3px;
    font-size: 13px; padding: 4px;
}
QPlainTextEdit {
    background-color: @contentBg; color: @text; border: none;
    font-family: Consolas, "Courier New", monospace; font-size: 13px;
}

/* ---- 滚动区: 跟随父容器背景 (未设置时视口用系统浅色调色板, 深色主题下会出现浅色底) ---- */
QScrollArea { border: none; background: transparent; }
#TerminalOutput { background-color: @terminalBg; color: @terminalFg; }
#TerminalPrompt { font-family: Consolas, monospace; font-weight: bold; color: @accent; }

/* ---- 按钮 ---- */
QPushButton {
    background-color: @buttonBg; color: @text; border: 1px solid @borderDim; border-radius: 3px;
    padding: 6px 16px; font-size: 13px; min-height: 20px;
}
QPushButton:hover { background-color: @buttonHover; border: 1px solid @border; }
QPushButton:pressed { background-color: @buttonPress; }
QPushButton:disabled { background-color: @buttonDisabledBg; color: @buttonDisabledText; border: 1px solid @borderDim; }
QPushButton[default="true"] { border: 1px solid @accent; }

/* ---- 表格 ---- */
QTableView {
    background-color: @contentBg; alternate-background-color: @altRowBg;
    gridline-color: @borderDim; selection-background-color: @selectionBg; selection-color: @text;
    border: none; font-size: 13px;
}
QTableView::item { padding: 3px 8px; min-height: 22px; border: none; }
QTableView::item:hover { background-color: @hoverBg; }
QTableView::item:selected { background-color: @selectionBg; }

QHeaderView::section {
    background-color: @headerBg; color: @textDim; padding: 5px 8px;
    border: none; border-right: 1px solid @borderDim; border-bottom: 1px solid @borderDim;
    font-size: 12px;
}
QHeaderView::section:hover { background-color: @headerHover; color: @text; }
/* 排序指示箭头 — 与 SpinBox/ComboBox 同款 chevron（原生三角在深色主题下不清晰） */
QHeaderView::up-arrow { image: url(@spinUp); width: 10px; height: 10px; }
QHeaderView::down-arrow { image: url(@spinDown); width: 10px; height: 10px; }

/* ---- 分割器 (1px, 透明→悬停 accent) ---- */
QSplitter::handle { background-color: transparent; }
QSplitter::handle:vertical { height: 1px; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:hover { background-color: @accent; }

/* ---- 滑块 ---- */
QSlider::groove:horizontal { border: none; height: 4px; background: @borderDim; border-radius: 2px; }
QSlider::sub-page:horizontal { background: @accent; border-radius: 2px; }
QSlider::add-page:horizontal { background: @borderDim; border-radius: 2px; }
QSlider::handle:horizontal { background: @accent; border: 2px solid @tabActiveBg; width: 12px; height: 12px; margin: -6px 0; border-radius: 8px; }
QSlider::handle:horizontal:hover { background: @accentHover; }

QSlider::groove:vertical { border: none; width: 4px; background: @borderDim; border-radius: 2px; }
QSlider::sub-page:vertical { background: @accent; border-radius: 2px; }
QSlider::add-page:vertical { background: @borderDim; border-radius: 2px; }
QSlider::handle:vertical { background: @accent; border: 2px solid @tabActiveBg; width: 12px; height: 12px; margin: 0 -6px; border-radius: 8px; }
QSlider::handle:vertical:hover { background: @accentHover; }

/* ---- 下拉框 ---- */
QComboBox {
    border: 1px solid @borderDim; border-radius: 3px; padding: 4px 8px;
    background-color: @contentBg; font-size: 13px; min-height: 22px;
}
QComboBox:hover { border: 1px solid @border; }
QComboBox:focus { border: 1px solid @accent; }
QComboBox:disabled { background-color: @buttonDisabledBg; color: @buttonDisabledText; }
QComboBox::drop-down { border: none; width: 26px; subcontrol-origin: padding; subcontrol-position: top right; }
QComboBox::down-arrow { image: url(@spinDown); width: 10px; height: 10px; }
QComboBox::down-arrow:hover { image: url(@spinDownHover); }
QComboBox QAbstractItemView {
    border: 1px solid @borderDim; background-color: @contentBg;
    selection-background-color: @selectionBg; selection-color: @text; outline: none; padding: 2px;
}
QComboBox QAbstractItemView::item { padding: 4px 8px; min-height: 22px; }

/* ---- 状态栏 (24px) ---- */
QStatusBar { background-color: @statusBg; color: @statusFg; border: none; font-size: 12px; max-height: 24px; }
QStatusBar::item { border: none; }
QStatusBar QLabel { color: @statusFg; padding: 0 8px; }

/* ---- 复选框 ---- */
QCheckBox { color: @text; font-size: 13px; spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid @border; border-radius: 3px; background: @contentBg; }
QCheckBox::indicator:checked { background: @accent; border: 1px solid @accent; image: url(:/icons/check.svg); }
QCheckBox::indicator:indeterminate { background: @accent; border: 1px solid @accent; image: url(@checkIndet); }
QCheckBox::indicator:hover { border: 1px solid @accent; }
QCheckBox::indicator:checked:hover { border: 1px solid @accentBorder; }

/* 条目视图勾选框（树/列表/表格的可勾选项）与 QCheckBox 同风格，
   否则回退到原生浅色方块，深色主题下刺眼 */
QTreeView::indicator, QListView::indicator, QTableView::indicator {
    width: 16px; height: 16px; border: 1px solid @border; border-radius: 3px; background: @contentBg;
}
QTreeView::indicator:checked, QListView::indicator:checked, QTableView::indicator:checked {
    background: @accent; border: 1px solid @accent; image: url(:/icons/check.svg);
}
QTreeView::indicator:indeterminate, QListView::indicator:indeterminate, QTableView::indicator:indeterminate {
    background: @accent; border: 1px solid @accent; image: url(@checkIndet);
}
QTreeView::indicator:hover, QListView::indicator:hover, QTableView::indicator:hover { border: 1px solid @accent; }
QTreeView::indicator:checked:hover, QListView::indicator:checked:hover, QTableView::indicator:checked:hover { border: 1px solid @accentBorder; }

/* ---- 单选按钮 ---- */
QRadioButton { color: @text; font-size: 13px; spacing: 8px; }
QRadioButton::indicator { width: 14px; height: 14px; border: 2px solid @border; border-radius: 8px; background: @contentBg; }
QRadioButton::indicator:checked { background: @contentBg; border: 2px solid @accent; image: url(@radioDot); }
QRadioButton::indicator:hover { border: 2px solid @accent; }

/* ---- GroupBox (扁平, 无圆角) ---- */
QGroupBox {
    border: 1px solid @borderDim; border-radius: 0; margin-top: 14px; padding: 10px; padding-top: 14px;
    font-size: 13px; font-weight: 600; color: @textDim;
}
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; }

/* ---- 对话框 ---- */
QDialog { background-color: @windowBg; }
QTextBrowser { background-color: @contentBg; color: @text; border: 1px solid @borderDim; font-size: 13px; }
QDialogButtonBox QPushButton { min-width: 80px; }

/* ---- 列筛选弹出面板（Trace 表头漏斗触发的 Excel 风格面板）----
   原先内联硬编码白色背景，深色主题下刺眼；改由全局 QSS 接管 */
#ColumnFilterPopup { background-color: @contentBg; border: 1px solid @border; }
#ColumnFilterPopup QListWidget { background-color: @contentBg; border: none; }

/* ---- SpinBox (加大上下箭头按钮) ---- */
QSpinBox, QDoubleSpinBox {
    border: 1px solid @borderDim; border-radius: 3px; padding: 4px 28px 4px 8px;
    background-color: @contentBg; font-size: 13px; min-height: 22px;
}
QSpinBox:hover, QDoubleSpinBox:hover { border: 1px solid @border; }
QSpinBox:focus, QDoubleSpinBox:focus { border: 1px solid @accent; }
QSpinBox:disabled, QDoubleSpinBox:disabled { background-color: @buttonDisabledBg; color: @buttonDisabledText; }

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border; subcontrol-position: top right;
    width: 24px; height: 14px; border: none; border-left: 1px solid @borderDim;
    border-top-right-radius: 3px; background: @panelBg;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover { background: @hoverBg; }
QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed { background: @buttonPress; }
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border; subcontrol-position: bottom right;
    width: 24px; height: 14px; border: none; border-left: 1px solid @borderDim;
    border-bottom-right-radius: 3px; background: @panelBg;
}
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover { background: @hoverBg; }
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed { background: @buttonPress; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(@spinUp); width: 10px; height: 10px; }
QSpinBox::up-arrow:hover, QDoubleSpinBox::up-arrow:hover { image: url(@spinUpHover); }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(@spinDown); width: 10px; height: 10px; }
QSpinBox::down-arrow:hover, QDoubleSpinBox::down-arrow:hover { image: url(@spinDownHover); }

/* ---- 进度条 ---- */
QProgressBar {
    border: 1px solid @borderDim; border-radius: 3px; background: @panelBg; text-align: center; font-size: 12px; min-height: 20px;
}
QProgressBar::chunk { background-color: @accent; border-radius: 2px; }

/* ---- 表格控件 (底部面板用) ---- */
QTableWidget {
    background-color: @sidebarBg; alternate-background-color: @altRowBg;
    border: none; gridline-color: @borderDim; font-size: 13px;
}
QTableWidget::item { padding: 4px 8px; min-height: 22px; }
QTableWidget::item:selected { background-color: @selectionBg; }

/* ---- 滚动条 (10px, VS Code 风格) ---- */
QScrollBar:vertical { border: none; background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: @scrollHandle; min-height: 30px; border-radius: 5px; margin: 1px; }
QScrollBar::handle:vertical:hover { background: @scrollHandleHover; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal { border: none; background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: @scrollHandle; min-width: 30px; border-radius: 5px; margin: 1px; }
QScrollBar::handle:horizontal:hover { background: @scrollHandleHover; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

/* ---- 工具提示 ---- */
QToolTip { background-color: @contentBg; color: @text; border: 1px solid @border; border-radius: 2px; padding: 4px 8px; font-size: 12px; }

/* ---- 窗口控制按钮 (SVG 图标, 10px) ---- */
#WindowButtons { background-color: transparent; }
#WinMinBtn, #WinMaxBtn { background: transparent; color: @barFg; border: none; }
#WinMinBtn:hover, #WinMaxBtn:hover { background-color: @barHover; }
#WinMinBtn:pressed, #WinMaxBtn:pressed { background-color: @accent; }
#WinCloseBtn { background: transparent; color: @barFg; border: none; }
#WinCloseBtn:hover { background-color: @closeBtnHover; }
#WinCloseBtn:pressed { background-color: @closeBtnPress; }
