# ---- 构建目录 ----
build/
build-*/
out/
debug/
release/

# ---- CMake ----
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeUserPresets.json
Makefile
*.cmake
!CMakeLists.txt

# ---- Qt 自动生成 ----
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
*.qmlc
*.qmltc
*_qmlcache.qrc

# ---- Qt Creator / VS ----
*.user
*.user.*
*.autosave
CMakeSettings.json
.vs/
.vscode/

# ---- 编译产物 ----
*.o
*.obj
*.exe
*.dll
*.lib
*.a
*.so
*.pdb

# Keep vendored USB-CAN runtime DLLs that the build copies into drivers/*/vendor
!third_party/PCAN-Basic/**/*.dll
!third_party/bmapi-sdk/bin/win64/BMAPI64.dll
!drivers/*/vendor/*.dll

# ---- BUSMUST SDK bulky extract (headers+DLL are kept; full zip is not) ----
third_party/bmapi-sdk/_extract/
third_party/bmapi-sdk/*.zip
third_party/bmapi-sdk/tree.json
third_party/bmapi-sdk/release.json

# ---- 操作系统 ----
Thumbs.db
.DS_Store
desktop.ini

# ---- 构建加速工具 (本地下载，不入库) ----
tools/

# ---- 构建日志和临时文件 (编译中间产物，不跟踪) ----
build_*.log
build_*.txt
asc_err*.txt
sin_stderr.txt
sin_stdout.txt
aqtinstall.log

# ---- 录制数据文件 (运行时生成，不跟踪) ----
*.sin
third_party/vector_blf
